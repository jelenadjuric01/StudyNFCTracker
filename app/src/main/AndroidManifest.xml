<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.NFC" />

    <!--
      Silencing notifications is the whole point of the app, so a phone without this
      permission cannot run it usefully. It is a special access grant: the user has to
      switch it on in Settings, which MainActivity walks them to.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyTracker">

        <!-- Setup screen: grant DND access, program the two tags, see current state. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The tap handler. No window of its own: it runs, toasts, and finishes.

          The NDEF_DISCOVERED filter with an app-specific MIME type is what lets a tap
          launch this activity even when the app is closed. A plain URL record could not
          do that — Android would open a browser instead.

          excludeFromRecents + noHistory keep an invisible screen out of the recents
          list; taskAffinity="" stops it being folded into MainActivity's task, so
          tapping a tag never resurrects the setup screen behind it.

          exported="true" is what tag dispatch requires, and it cannot be narrowed:
          Android delivers NDEF_DISCOVERED itself, so no permission can be demanded of
          the sender. Any other app on the phone could therefore fake this intent and
          toggle study mode. Accepted deliberately — the worst it can do is silence a
          phone and miscount study minutes, both of which the owner can undo with a tap.
          Anything genuinely worth protecting must not be reached from here.
        -->
        <activity
            android:name=".TagIntentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.StudyTracker.Invisible">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.com.jelena.studytracker" />
            </intent-filter>
        </activity>
    </application>

</manifest>
