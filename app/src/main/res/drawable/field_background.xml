<?xml version="1.0" encoding="utf-8"?>
<!-- The box around an editable number, so it reads as something you can type into. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/ide_field" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="@color/ide_border" />
</shape>
