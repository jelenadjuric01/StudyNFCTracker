<?xml version="1.0" encoding="utf-8"?>
<!--
  The status bar icon. It must be a single flat shape in white on transparent: Android throws away
  the colours and keeps only the alpha channel, so anything else turns into a white blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- An alarm clock: a circle, two feet, and a pair of hands. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,4a8,8 0 1,0 0.01,0zM11,7h2v5.5l4,2.4l-1,1.7l-5,-3z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.5,3.3l1.4,-1.4l2.8,2.4l-1.3,1.5zM19.5,3.3l-1.4,-1.4l-2.8,2.4l1.3,1.5z" />
</vector>
