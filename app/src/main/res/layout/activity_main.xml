<?xml version="1.0" encoding="utf-8"?>
<!--
  A ScrollView because the content is taller than a phone screen — without it the history at
  the bottom is unreachable.

  It also handles system bar insets, and so must not set its own padding: fitsSystemWindows
  overwrites padding with the inset values. The inner layout owns the spacing instead.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceHeadlineSmall" />

        <!-- 1. Permission. Nothing else in the app works until this is granted. -->
        <TextView
            android:id="@+id/dndStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <Button
            android:id="@+id/grantDndButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_dnd" />

        <!-- 2. Programming the tags. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/write_instructions"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <RadioGroup
            android:id="@+id/tagChoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/chooseStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tag_study" />

            <RadioButton
                android:id="@+id/chooseSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/tag_switch" />

        </RadioGroup>

        <TextView
            android:id="@+id/nfcStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/writeStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- 3. The auto-close cap: how long a session may run if the closing tap is forgotten. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/cap_instructions"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/capHoursInput"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1" />

            <!-- labelFor is what makes a screen reader announce the box as the hours field. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:labelFor="@id/capHoursInput"
                android:text="@string/unit_hours" />

            <EditText
                android:id="@+id/capMinutesInput"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:labelFor="@id/capMinutesInput"
                android:text="@string/unit_minutes" />

            <Button
                android:id="@+id/saveCapButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/cap_save" />

        </LinearLayout>

        <TextView
            android:id="@+id/capStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/alarmStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/grantAlarmButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_alarm" />

        <!-- 4. What the last tap left study mode doing, and the hours recorded so far. -->
        <TextView
            android:id="@+id/studyStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/runningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Monospaced so the durations line up into a column. -->
        <TextView
            android:id="@+id/todayText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

    </LinearLayout>

</ScrollView>
