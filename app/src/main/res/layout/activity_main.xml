<?xml version="1.0" encoding="utf-8"?>
<!--
  The screen is a column of three: a title, a scrolling middle, and the tab bar.

  Only the middle scrolls, so the title and the tabs stay put — which is why the ScrollView is one
  child of a LinearLayout rather than the root.

  fitsSystemWindows belongs on this root and nowhere else: it replaces the view's padding with the
  status- and navigation-bar insets, so anything that sets its own padding would lose it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/ide_text" />

    <!-- The JetBrains gradient, as a hairline under the title. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/brand_gradient" />

    <!--
      layout_height="0dp" with a weight is the LinearLayout idiom for "take whatever is left": the
      title and the tab bar are measured first, and this fills the gap between them.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!--
              One panel per tab. All three live here at once and the tab bar shows one and hides the
              other two — far less machinery than fragments, and every view stays reachable through
              a single binding.
            -->

            <!-- ===== Tab 1: the session. What study mode is doing, and the hours so far. ===== -->
            <LinearLayout
                android:id="@+id/sessionPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_status" />

                        <TextView
                            android:id="@+id/studyStateText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/ide_text" />

                        <TextView
                            android:id="@+id/runningText"
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_recorded" />

                        <!-- Monospaced so the durations line up into a column. -->
                        <TextView
                            android:id="@+id/todayText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/ide_text" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== Tab 2: programming the two tags. ===== -->
            <LinearLayout
                android:id="@+id/tagsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_write_tag" />

                        <TextView
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/write_instructions" />

                        <RadioGroup
                            android:id="@+id/tagChoice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical">

                            <RadioButton
                                android:id="@+id/chooseStudy"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/tag_study"
                                android:textColor="@color/ide_text" />

                            <RadioButton
                                android:id="@+id/chooseSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tag_switch"
                                android:textColor="@color/ide_text" />

                        </RadioGroup>

                        <TextView
                            android:id="@+id/nfcStatusText"
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <TextView
                            android:id="@+id/writeStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/jb_pink" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== Tab 3: the one-off setup — permissions and the auto-close cap. ===== -->
            <LinearLayout
                android:id="@+id/setupPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Nothing in the app works until this is granted, so it comes first. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_dnd" />

                        <TextView
                            android:id="@+id/dndStatusText"
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/grantDndButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/grant_dnd" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_auto_close" />

                        <TextView
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/cap_instructions" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/capHoursInput"
                                style="@style/NumberField"
                                android:importantForAutofill="no" />

                            <!-- labelFor is what makes a screen reader announce the box as the hours field. -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:labelFor="@id/capHoursInput"
                                android:text="@string/unit_hours"
                                android:textColor="@color/ide_text_dim" />

                            <EditText
                                android:id="@+id/capMinutesInput"
                                style="@style/NumberField"
                                android:importantForAutofill="no"
                                android:layout_marginStart="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:labelFor="@id/capMinutesInput"
                                android:text="@string/unit_minutes"
                                android:textColor="@color/ide_text_dim" />

                            <Button
                                android:id="@+id/saveCapButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="@string/cap_save" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/capStatusText"
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Hidden whole when the cap is off: with no auto-close there is no alarm to ask about. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/alarmCard"
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            style="@style/CardTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_alarm" />

                        <TextView
                            android:id="@+id/alarmStatusText"
                            style="@style/Explanation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <Button
                            android:id="@+id/grantAlarmButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/grant_alarm" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ide_surface"
        app:itemIconTint="@color/nav_item_tint"
        app:itemTextColor="@color/nav_item_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
